async function addVisit() {
  const symptoms = document.getElementById('visit-symp').value;
  const diagnosis = document.getElementById('visit-diag').value;
  
  if (!symptoms || !diagnosis) return showNotification('Fill symptoms and diagnosis correctly', 'error');

  const payload = { patient_id: activePatientId, symptoms, diagnosis };

  if (!navigator.onLine) {
    await saveToOfflineQueue('visit', payload);
    showNotification('Offline mode. Clinical visit footprint safely queued locally.', 'success');
    document.getElementById('visit-symp').value = '';
    document.getElementById('visit-diag').value = '';
    return;
  }

  try {
    const res = await fetch(`${API_URL}/visit/add`, {
      method: 'POST',
      headers: { ...getAuthHeaders(), 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    
    if (res.ok) {
      showNotification('Clinical visit footprint added to DB successfully!');
      document.getElementById('visit-symp').value = '';
      document.getElementById('visit-diag').value = '';
      loadPatientHistory(activePatientId);
    } else throw new Error((await res.json()).message);
  } catch(e) { showNotification(e.message, 'error'); }
}

async function uploadReport() {
  const fileInput = document.getElementById('report-file');
  if(!fileInput.files[0]) return showNotification('Please securely select an image/PDF file to process', 'error');
  
  const file = fileInput.files[0];
  
  if (!navigator.onLine) {
    await saveToOfflineQueue('report', { patient_id: activePatientId, fileName: file.name }, file);
    showNotification('Offline mode. Native report safely queued for delayed upload pipeline.', 'success');
    fileInput.value = '';
    return;
  }
  
  const formData = new FormData();
  formData.append('file', file);
  formData.append('patient_id', activePatientId);
  
  showNotification('Uploading... Pumping payload into Python OCR/NLP microservices pipelining...', 'success');
  
  try {
    const res = await fetch(`${API_URL}/report/process`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${currentToken}` },
      body: formData
    });
    
    if (res.ok) {
      showNotification('OCR and Natural Language Processing successful!');
      fileInput.value = ''; 
      loadPatientHistory(activePatientId);
    } else {
        const failData = await res.json();
        throw new Error(failData.error && failData.error.error ? failData.error.error : failData.message);
    }
  } catch(e) { showNotification(e.message, 'error'); }
}
