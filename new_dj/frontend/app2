  document.getElementById('doc-active-pat-name').textContent = document.getElementById('found-pat-name').textContent;
  document.getElementById('doc-idle').style.display = 'none';
  document.getElementById('doc-active-patient').style.display = 'block';
  
  document.getElementById('doc-history-list').innerHTML = '';
